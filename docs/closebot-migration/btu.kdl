MultiObjective id="166b4528-b656-44f5-b156-d48a02e1fea5" {
    Objectives {
        _ {
            Variable "contact.address"
            Title "Get Full Address"
            Description "Get the contact's full address"
            Prompt "Ask for the contact's full address including street, city, and zip code. Explain that we need it to confirm we service their area and so our designer knows where to come for the free in-home consultation. Only ask once. If they say they are in Manhattan, Brooklyn, Queens, the Bronx, Staten Island, any NYC borough, Hudson County, or Bergen County, politely let them know we do not service their area, thank them for reaching out, and end the conversation. Do not continue collecting information from out-of-area leads. If they provide an address in our service area, confirm it and move forward to booking."
            MaxAttempts 3
            Sensitivity 50
            SkipIfNotBlank true
        }
    }
    __dynamicVariables
    isScenarioDescendant false
    activeAiInScenario false
    Next handle="56c10648-0d94-42e2-84bf-d38db2334a60"
    __position -633.8646 -1082.6465
}
