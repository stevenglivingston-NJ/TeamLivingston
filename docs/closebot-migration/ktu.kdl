MultiObjective id="eb177088-8831-4f76-8e12-80d53d1d4d7e" {
    Objectives {
        _ {
            Variable "contact.phone"
            Title "Get Phone "
            Description "Ask for the contact's phone number so we can send their consultation reminder and stay in touch. Only ask once. If they decline, say no, or ask not to be called, accept it immediately, move on, and do not ask again. Never ask for the same information twice. If they provide a number, confirm it back to them and move forward."
            Prompt "Ensure phone number is valid format. "
            MaxAttempts 3
            Sensitivity 50
            SkipIfNotBlank true
        }
    }
    __dynamicVariables
    isScenarioDescendant false
    activeAiInScenario false
    Next handle="ed1fc5fb-b0c9-43df-b809-5989e3e39142-1778381684206-1778381754069"
