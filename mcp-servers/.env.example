# =============================================================================
# MCP server API keys — set these in the Cloud environment's env-var config
# (Cloud env → Environment variables). bootstrap.sh reads them to register the
# custom stdio MCP servers on every fresh session.
#
# These are SECRETS. This .example file lists NAMES ONLY — never commit real
# values. Paste the real values into the environment config, not the repo.
# =============================================================================

# ---- KTU / BTU ----
CLOSEBOT_API_KEY=
COMPANYCAM_TOKEN=
SM_KEY_KTU=
SM_KEY_BTU=
# ServiceMinder Org-Level Download API requires a UserId (runs the export "as" a user).
# Set to any active Owner/Org-Admin UserId per location (find via list_users). Used as the
# default for start_download so headless agent runs (Goldeneye) don't have to look one up.
SM_USERID_KTU=
SM_USERID_BTU=

# Google Ads (OAuth2 desktop client) — shared by the STDIO google-ads AND gmb
# servers. NOTE: if you use the Render-hosted google-ads instead (via
# GOOGLEADS_MCP_AUTH_TOKEN below), these four are only needed for the `gmb`
# server — the Render service already holds its own copy of the Google creds.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# MCC / manager-account id (10 digits, dashes ok — server strips them).
# Required for LSA queries (query_lsa_account / query_lsa_leads); leave blank if no MCC.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Render-hosted Google Ads + LSA MCP (ktubtu-mcp-google-ads) — the service's
# auto-generated MCP_AUTH_TOKEN (Render → ktubtu-mcp-google-ads → Environment).
# Registers `google-ads` (search + Local Services Ads) as a static-bearer HTTP
# MCP server for Cloud sessions / the paid agent, WITHOUT needing the Google
# OAuth creds in Cloud env (they live in Render). NOT a claude.ai connector
# (OAuth-only). This is the fast path to light up Google Ads + LSA for Paid.
GOOGLEADS_MCP_AUTH_TOKEN=

# Google Business Profile (gmb) — plus the three GOOGLE_ADS OAuth vars above
GMB_ACCOUNT_ID=
GMB_LOCATION_KTU=
GMB_LOCATION_BTU=

# GA4 (google-analytics) — direct GA4 Data API, replacing the Zapier raw-request
# path in paid.md. REQUIRES ITS OWN REFRESH TOKEN: GOOGLE_ADS_REFRESH_TOKEN above
# carries only adwords + business.manage scopes and 403s against GA4 (verified
# 2026-08-21). Mint GA4_REFRESH_TOKEN via a fresh OAuth consent for the same
# client with the analytics.readonly scope added. GA4_CLIENT_ID/SECRET default to
# the GOOGLE_ADS_* ones above if left blank (same OAuth app, different token).
GA4_CLIENT_ID=
GA4_CLIENT_SECRET=
GA4_REFRESH_TOKEN=
GA4_PROPERTY_ID_KTU=
GA4_PROPERTY_ID_BTU=

# HighLevel Private Integration Tokens (full value incl. the "pit-" prefix).
# bootstrap.sh registers ghl-ktu / ghl-btu against LeadConnector's hosted MCP
# endpoint (services.leadconnectorhq.com/mcp/) with the matching locationId.
GHL_PIT_KTU=
GHL_PIT_BTU=

# Microsoft Clarity — shared bearer tokens (~10 calls/project/day cap, shared
# across all Clarity server variants below).
#
# CLARITY_KTU_TOKEN / CLARITY_BTU_TOKEN are used by THREE servers:
#   1. clarity-live  — direct Python stdio MCP hitting the live-insights endpoint
#                      (https://www.clarity.ms/export-data/api/v1/project-live-insights)
#                      for both KTU + BTU. Registered by bootstrap.sh.
#   2. clarity-ktu-export / clarity-btu-export — npm @microsoft/clarity-mcp-server,
#                      broader dashboard / recordings / docs tools per project.
#   3. clarity       — Render-hosted HTTP MCP (ktubtu-mcp-clarity), needs its own
#                      CLARITY_MCP_AUTH_TOKEN (separate bearer for the Render service).
CLARITY_KTU_TOKEN=
CLARITY_BTU_TOKEN=

# Optional: override the hardcoded Clarity project IDs if the project is ever
# migrated or a new property is created (defaults: KTU=2708513173760009, BTU=2789761772911940).
CLARITY_KTU_PROJECT_ID=
CLARITY_BTU_PROJECT_ID=

# Render-hosted Clarity MCP (ktubtu-mcp-clarity) — the service's auto-generated
# MCP_AUTH_TOKEN (Render → ktubtu-mcp-clarity → Environment). Registers the
# hosted Data-Export wrapper (KTU+BTU) as a static-bearer HTTP MCP server so
# Cloud sessions / the paid agent can reach it. NOT usable as a claude.ai
# connector (those require OAuth; this service is static-bearer only).
CLARITY_MCP_AUTH_TOKEN=

# ---- Jatalia / Earthwise ----
SHIPSTATION_API_KEY=
AMAZON_SP_CLIENT_ID=
AMAZON_SP_CLIENT_SECRET=
AMAZON_SP_REFRESH_TOKEN=

# Shopify Admin API — headless price + unit-cost feed for the Jatalia/Earthwise
# sweep (mcp-servers/jatalia/shopify_costs.py). Replaces the old session-only
# claude.ai Shopify MCP + Coupler.io push, which could not run in a scheduled
# Routine. Create a custom app in Shopify admin (Settings > Apps > Develop apps),
# grant scopes read_products + read_inventory (read_inventory is required for
# inventoryItem.unitCost), install, and copy the Admin API access token.
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_SHOP_DOMAIN=earthwiseseed.myshopify.com

# Walmart Marketplace — returns + catalog feed for the sweep (RETURNS_HIGH /
# shipping P&L). OAuth client_credentials (Basic auth → /v3/token); no signature.
# Creds from Walmart Developer portal → Seller account.
WMT_CLIENT_ID=
WMT_CLIENT_SECRET=
WMT_SELLER_ID=

# Walmart Ads (Walmart Connect / Sponsored Search — Harvest lane). SEPARATE creds
# issued in Ad Center → Settings → API Access. OAuth Basic auth → /v3/token; the
# live API uses the bearer token only (no request signature). advertiserId scopes
# the account.
WMT_ADS_CLIENT_ID=
WMT_ADS_CLIENT_SECRET=
WMT_ADS_ADVERTISER_ID=

# Amazon Ads (Harvest — demand/ROAS; a repo amazon-ads server is a follow-on to
# amazon-sp). LWA credentials from the Amazon Ads API console. These already
# exist for the Jatalia account (Ads profile 1035588453215307); paste them here
# to light up Amazon Ads in the Cloud env once the server lands.
AMAZON_ADS_CLIENT_ID=
AMAZON_ADS_CLIENT_SECRET=
AMAZON_ADS_REFRESH_TOKEN=
AMAZON_ADS_PROFILE_ID=
AMAZON_ADS_REGION=NA

# ---- Shared ----
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Supabase intranet DB (project tguwpswcneywvscxzyef). Used by mcp-servers/sb.sh,
# the curl→PostgREST helper the agents call so scheduled Routines read/write the
# intranet WITHOUT the Auto-mode "Execute SQL" permission prompt (Bash isn't
# classifier-gated; the mcp__Supabase__execute_sql tool is). Service-role key —
# bypasses RLS; keep it a secret. URL is .supabase.co (NOT .com — sb.sh corrects
# the typo defensively, but set it right here).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
